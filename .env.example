# Groq (free tier — no payment required, 30 requests/min)
# Get your key at: https://console.groq.com
GROQ_API_KEY=GROQ_API_KEY

# Groq model (options: mixtral-8x7b-32768, llama3-70b-8192, llama3-8b-8192, gemma2-9b-it)
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgreS@localhost:5432/candidate_screener

# Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Chroma Persistent Directory
CHROMA_PERSIST_DIR=./chroma_db

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Session
MAX_QUESTIONS_PER_SESSION=10